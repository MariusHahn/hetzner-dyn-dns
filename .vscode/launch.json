{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Debug pytest - current file",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/.venv/bin/pytest",
      "args": [
        "${file}",
        "-q"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {},
      "cwd": "${workspaceFolder}"
    }
  ]
}